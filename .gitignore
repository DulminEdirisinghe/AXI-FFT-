# ============================================================
#  Vivado (hardware project in work_proj/dma)
#  Keep: dma.xpr, dma.srcs/sources_1/bd/** (.bd, .xci, ui), src/, tb/
#  Everything below is regenerated by Vivado
# ============================================================
work_proj/dma/dma.cache/
work_proj/dma/dma.gen/
work_proj/dma/dma.hw/
work_proj/dma/dma.ip_user_files/
work_proj/dma/dma.runs/
work_proj/dma/dma.sim/
work_proj/dma/dma.srcs/utils_1/
work_proj/dma/.Xil/

# Generated alongside the BD sources
*.bda
*.dcp
*.jou
*.log
*.str
*.backup.*
.Xil/
vivado_pid*.zip
webtalk*
xsim.dir/
*.wdb

# ============================================================
#  Vitis unified IDE (sw/)
#  Keep: sw/dma_app/src/**, vitis-comp.json files, platform .xsa
# ============================================================
# Build outputs
sw/**/build/
sw/**/export/
sw/**/logs/
*.o
*.d
*.elf
*.lock
*.bin
*.pdi

# Platform BSP and SDT are regenerated from the .xsa
sw/dma_platform/microblaze_0/
sw/dma_platform/resources/
sw/dma_platform/hw/sdt/

# Bitstream copies made by the IDE
sw/dma_app/_ide/bitstream/
sw/dma_app/_ide/hwspec.checksum

# Workspace and IDE state
sw/_ide/
.vitisWorkspace.json
.wsdata/
_ide/.wsdata
workspace_journal*.py
compile_commands.json
.cache/
.clangd

# ============================================================
#  Misc
# ============================================================
__pycache__/
*.pyc
.vscode/
